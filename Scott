<!DOCTYPE html> <html lang="pt"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title>SCOTT ELECTRONICS LTD</title> <meta name="theme-color" content="#0f172a"> <style> *{box-sizing:border-box;font-family:system-ui,Arial} body{margin:0;background:#f1f5f9;padding-bottom:90px} .header{background:#0f172a;color:white;padding:20px 16px 16px;position:sticky;top:0;z-index:10} .header h1{margin:0;font-size:22px} .header p{margin:4px 0 12px;opacity:.8;font-size:13px} .search{width:100%;padding:12px;border-radius:12px;border:0;font-size:15px} .filters{display:flex;gap:8px;margin-top:12px;overflow-x:auto} .filters button{flex:0 0 auto;padding:10px 16px;border:0;border-radius:20px;background:#1e293b;color:white;cursor:pointer} .filters button.active{background:#f97316} .grid{padding:14px;display:grid;grid-template-columns:1fr 1fr;gap:12px} .card{background:white;border-radius:16px;overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.08)} .card img{width:100%;height:140px;object-fit:cover;background:#e2e8f0} .card-body{padding:10px} .card-body h3{margin:0;font-size:14px;line-height:1.2;min-height:34px} .price{color:#ea580c;font-weight:800;font-size:16px;margin:6px 0} .badge{font-size:11px;background:#dcfce7;color:#166534;padding:3px 7px;border-radius:20px} .badge-new{font-size:11px;background:#fef3c7;color:#92400e;padding:3px 7px;border-radius:20px} .btn{width:100%;background:#22c55e;color:white;border:0;padding:10px;border-radius:10px;font-weight:700;cursor:pointer} .footer{position:fixed;bottom:0;left:0;right:0;background:white;padding:12px;text-align:center;border-top:1px solid #e2e8f0;font-size:13px} </style> </head> <body> <div class="header"> <h1>SCOTT ELECTRONICS LTD 📱</h1> <p>Para Todos em Moçambique • Entrega em Todo País • M-Pesa / e-Mola</p> <input id="search" class="search" placeholder="Pesquisar... ex: A07, Redmi 14C, PS5" oninput="render()"> <div class="filters"> <button id="btnAll" class="active" onclick="setFilter('all')">Todos</button> <button id="btnIphone" onclick="setFilter('iphone')">🍎 iPhone</button> <button id="btnSamsung" onclick="setFilter('samsung')">📱 Samsung</button> <button id="btnRedmi" onclick="setFilter('redmi')">🔴 Redmi</button> <button id="btnPs5" onclick="setFilter('ps5')">🎮 PS5</button> </div> </div> <div id="grid" class="grid"></div> <div class="footer">✅ Originais com Garantia • 💬 Pedidos no WhatsApp</div> <script> const WHATSAPP_NUMBER = "258847083960"; const phones = [ ["iPhone XR 64GB",15500,"iphone",0],["iPhone XR 128GB",16700,"iphone",0],["iPhone 11 128GB",18500,"iphone",0],["iPhone 11 Pro 256GB",22800,"iphone",0],["iPhone 11 Pro Max 256GB",24000,"iphone",0], ["iPhone 12 64GB",20000,"iphone",0],["iPhone 12 128GB",21000,"iphone",0],["iPhone 12 Pro 256GB",28500,"iphone",0],["iPhone 13 256GB",28600,"iphone",0],["iPhone 13 Pro 256GB",37500,"iphone",0], ["iPhone 12 Pro Max 128GB",31000,"iphone",0],["iPhone 12 Pro Max 256GB",34000,"iphone",0],["iPhone 13 Pro Max 128GB",39000,"iphone",0],["iPhone 13 Pro Max 256GB",41500,"iphone",0], ["iPhone 14 256GB",31000,"iphone",0],["iPhone 14 Pro 256GB",44800,"iphone",0],["iPhone 14 Pro Max 256GB",46000,"iphone",0],["iPhone 15 128GB",42500,"iphone",0],["iPhone 15 Pro Max 256GB",55800,"iphone",0], ["Samsung S21 Ultra 128GB",25900,"samsung",0],["Samsung S21 Ultra 256GB",27000,"samsung",0],["Samsung S22 Ultra 256GB",35000,"samsung",0],["Samsung S23 Ultra 256GB",41900,"samsung",0],["Samsung S24 Ultra 256GB",52800,"samsung",0], ["Samsung Galaxy A07",8500,"samsung",1],["Samsung Galaxy A16 128GB",11800,"samsung",1],["Samsung Galaxy A17 128GB",13500,"samsung",1], ["Redmi A5",6800,"redmi",1],["Redmi 14C 16GB RAM / 256GB",10500,"redmi",1],["Redmi 15C 8GB / 128GB",10800,"redmi",1],["Redmi 15C 16GB RAM / 256GB",12800,"redmi",1], ["Sony PS5 Slim - Novo Selado",38500,"ps5",1] ]; let filter="all"; function setFilter(f){filter=f;document.querySelectorAll('.filters button').forEach(b=>b.classList.remove('active'));document.getElementById('btn'+(f=='all'?'All':f=='iphone'?'Iphone':f=='samsung'?'Samsung':f=='redmi'?'Redmi':'Ps5')).classList.add('active');render()} function render(){  const q=document.getElementById('search').value.toLowerCase();  const grid=document.getElementById('grid'); grid.innerHTML="";  phones.filter(p=>(filter=='all'||p[2]==filter)&&p[0].toLowerCase().includes(q)).forEach(p=>{   let img="";   if(p[2]=='iphone') img='https://images.unsplash.com/photo-1592750475338-74b7b21085ab?w=500';   else if(p[2]=='samsung') img='https://images.unsplash.com/photo-1610945265064-0e34e5519bbf?w=500';   else if(p[2]=='redmi') img='https://images.unsplash.com/photo-1598327105666-5b89351aff97?w=500';   else img='https://images.unsplash.com/photo-1606813907291-d86efa9b94db?w=500';   let badge = p[3]==1 ? '<span class="badge-new">🔥 NOVO STOCK</span>' : '<span class="badge">✅ Disponível</span>';   grid.innerHTML+=`<div class="card"><img src="${img}"><div class="card-body">${badge}<h3>${p[0]}</h3><div class="price">${p[1].toLocaleString('pt-MZ')} MT</div><button class="btn" onclick="buy('${p[0]}','${p[1]}')">Comprar no WhatsApp</button></div></div>`;  }); } function buy(name,price){  const msg=encodeURIComponent(`Olá SCOTT ELECTRONICS! Quero comprar: ${name} - ${price} MT. Ainda está disponível?`);  window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${msg}`,'_blank'); } render(); </script> </body> </html>
